NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solo necesaria para "Importar menú desde PDF" (admin/menu/importar).
# Se consigue en console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Delivery -------------------------------------------------------------------
# JWT Secret del proyecto (Supabase > Project Settings > API). Firma la sesion
# de los repartidores (entran con PIN, sin cuenta de Auth). Solo en el servidor.
SUPABASE_JWT_SECRET=
# Secreto del cron que purga el rastro GPS viejo (POST /api/delivery/purgar-rastro).
CRON_SECRET=
